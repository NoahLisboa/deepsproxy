# Porta do servidor (default: 3000)
PORT=3000

# Chave de API para proteger endpoints (opcional)
API_KEY=sua-chave-secreta-aqui

# Backend selecionado ao iniciar: deepseek ou custom
PROXY_BACKEND=deepseek
# Para PROXY_BACKEND=custom (AnyRouter OpenAI-compatible)
ANYROUTER_API_BASE_URL=https://anyrouter.dev/api/v1
ANYROUTER_API_KEY=sk-ar-v1-sua-chave-aqui
ANYROUTER_MODEL=dots-studio/dots-3-note-preview

# Link temporário para importar storage-state.json de um navegador logado
LOGIN_SETUP_TOKEN=troque-por-um-token-longo

# Configurações Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
# Diretório persistente que contém a sessão autenticada do Chat Web
DEEPSEEK_PROFILE_DIR=deepseek_profile

# Tools locais (opt-in para exposição automática no chat)
ENABLE_LOCAL_TOOLS=false
DEEPSPROXY_MAX_TOOL_TURNS=8
TOOL_WORKSPACE=.
TOOL_TIMEOUT_MS=30000
TOOL_MAX_OUTPUT_CHARS=20000

# Logging
LOG_LEVEL=info
